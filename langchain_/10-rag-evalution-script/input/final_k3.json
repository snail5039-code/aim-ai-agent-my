{
  "experiment_name": "final_k3",
  "description": "최종 후보 - 청크 300/50, top_k=3, similarity vs hybrid를 RAGAS까지 비교",
  "data": {
    "document_dir": "../data/public",
    "document_glob": "*.pdf",
    "golden_set_path": "../data/public/public_paragraph_golden_set.json"
  },
  "chunking": {
    "chunk_size": 300,
    "chunk_overlap": 50,
    "separators": null
  },
  "embedding": {
    "provider": "google",
    "model": "gemini-embedding-001"
  },
  "index": {
    "persist_dir": "./.index_cache",
    "rebuild": false
  },
  "retrieval": {
    "top_k": 3,
    "methods": [
      {
        "name": "similarity"
      },
      {
        "name": "hybrid",
        "weights": [
          0.5,
          0.5
        ]
      }
    ]
  },
  "generation": {
    "enabled": true,
    "model": "gemini-3.6-flash",
    "temperature": 0.0,
    "max_concurrency": 4
  },
  "evaluation": {
    "retrieval": {
      "enabled": true,
      "k_list": [
        1,
        3
      ]
    },
    "ragas": {
      "enabled": true,
      "metrics": [
        "faithfulness",
        "answer_relevancy"
      ],
      "methods": [
        "similarity",
        "hybrid"
      ],
      "sample_size": null,
      "max_concurrency": 4
    }
  }
}
