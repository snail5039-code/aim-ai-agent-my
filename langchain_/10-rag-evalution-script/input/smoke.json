{
  "experiment_name": "smoke",
  "description": "회귀용 스모크 - bm25만 쓰므로 API 호출 0회. 청킹은 chunk_300과 동일해 인덱스 캐시를 재사용한다.",
  "data": {
    "document_dir": "../data/public",
    "document_glob": "*.pdf",
    "golden_set_path": "../data/public/public_paragraph_golden_set.json"
  },
  "chunking": {
    "chunk_size": 300,
    "chunk_overlap": 50,
    "separators": null
  },
  "embedding": {
    "provider": "google",
    "model": "gemini-embedding-001"
  },
  "index": {
    "persist_dir": "./.index_cache",
    "rebuild": false
  },
  "retrieval": {
    "top_k": 5,
    "methods": [
      {
        "name": "bm25",
        "tokenizer": "kiwi"
      }
    ]
  },
  "generation": {
    "enabled": false,
    "model": "gemini-3.6-flash",
    "temperature": 0.0,
    "max_concurrency": 4
  },
  "evaluation": {
    "retrieval": {
      "enabled": true,
      "k_list": [
        1,
        3,
        5
      ]
    },
    "ragas": {
      "enabled": false,
      "metrics": [
        "faithfulness",
        "answer_relevancy"
      ],
      "methods": null,
      "sample_size": null,
      "max_concurrency": 4
    }
  }
}
